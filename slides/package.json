{
	"name": "slides",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "slidev build",
		"dev": "slidev --open",
		"export": "slidev export",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"ttyd": "ttyd -p 7681 -W -t fontSize=15 -t disableLeaveAlert=true zsh"
	},
	"dependencies": {
		"@fontsource/source-code-pro": "^5.2.7",
		"@slidev/cli": "^52.15.0",
		"@slidev/theme-default": "latest",
		"vue": "^3.5.33"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14"
	}
}
