{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "color-swipe",
	"main": "src/worker.ts",
	"compatibility_date": "2026-05-17",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"],
	},
	"observability": {
		"enabled": true,
	},
}
